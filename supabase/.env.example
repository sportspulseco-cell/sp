# Template for supabase/.env.local — copy and fill in.
# Push to Supabase with:
#   supabase secrets set --env-file supabase/.env.local

# Hugging Face Spaces base URL for the CP-SAT solver.
SOLVER_URL=https://<your-hf-username>-scheduler-solver.hf.space

# Must match the SOLVER_API_KEY secret set on the HF Space.
SOLVER_API_KEY=replace-with-the-value-from-the-hf-space-secret
