NODE_ENV=development
API_PORT=4000
# Set true only if the Swagger UI must be served in production.
ENABLE_API_DOCS=false
# Comma-separated list of origins allowed by enableCors(). MUST include
# every web surface that talks to this API — locally + on Vercel. The
# preflight is silently rejected (no Allow-Origin header) for origins
# not listed here, which manifests as "Failed to fetch" in the browser
# (BUG-018).
CORS_ORIGIN=https://superadmin.sportspulse.us,https://league.sportspulse.us,https://org.sportspulse.us,https://player.sportspulse.us,https://team.sportspulse.us,https://sportspulse.us,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3010,http://localhost:3011,http://localhost:3012,http://localhost:3013,http://localhost:3014

# Postgres — use the pooled URL at runtime
DATABASE_POOL_URL=postgresql://postgres.<project_ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# Per-instance pool. All serverless instances share the pooler's client cap.
DATABASE_POOL_MAX=4
DATABASE_IDLE_TIMEOUT_S=2

# Supabase Auth
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email). Leave RESEND_API_KEY empty to run in
# log-only mode — the API still surfaces rendered messages to the
# admin UI as a copy/paste fallback. EMAIL_FROM_ADDRESS defaults to
# Resend's onboarding sandbox, which only delivers to verified
# addresses on the free tier; set this to a verified domain before
# inviting real users.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=notifications@sportspulse.us

# Public-facing URL for the superadmin web app — used in email bodies
# (sign-in links, etc).
SUPERADMIN_WEB_URL=http://localhost:3000
LEAGUE_ADMIN_WEB_URL=https://league.sportspulse.us

# Public-facing URL for player-web — used to build parent-consent
# portal URLs in emails sent to the minor registrant's parent.
PLAYER_WEB_URL=https://player.sportspulse.us

# Shared secret for pg_cron-driven endpoints (notifications retry,
# materialised-view refresh). pg_cron + pg_net post with
# `X-Cron-Secret: ${CRON_SECRET}`. Generate a long random string per
# environment; never log or commit. Migration 0034 sets the matching
# value in Postgres via `ALTER DATABASE ... SET app.cron_secret`.
CRON_SECRET=

# Web Push (VAPID). With either key unset, push rows end `suppressed`
# with "not sent: push notifications are not set up" and the player
# settings page says so. Generate one pair per environment:
#   npx web-push generate-vapid-keys
# The public key is served to browsers by GET /communications/push/config;
# the web apps need no copy of it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@sportspulse.us

# Set to "true" in environments where new users must verify their
# email before they can sign in. Default (unset / "false") auto-
# confirms on user creation — fine for local + staging mock flows.
# With this flag on, Supabase sends a confirmation link to every new
# user; each app's /auth/callback exchanges the code for a session.
SUPABASE_REQUIRE_EMAIL_CONFIRM=false

# SMS (Twilio Programmable Messaging). With these unset, SMS rows end
# `suppressed` with "not sent: SMS is not set up for this league" and
# the settings page says text messages are not set up. Set the account
# SID, auth token and either a sender number or a Messaging Service SID.
# TWILIO_API_BASE_URL is for tests against a fake provider only; leave
# it unset in every deployed environment.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_API_BASE_URL=

# UC-29 licence scans: HMAC key for the stored licence-number hash
# (compliance_id_checks.licence_hash). At least 32 random characters,
# one per environment, never rotated casually (rotating breaks matching
# a licence seen before). Unset: licence checks answer 503.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ID_CHECK_HASH_KEY=
